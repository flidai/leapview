{
  "$defs": {
    "#APIVersion": {
      "const": "leapview.dev/v1"
    },
    "#IncludeList": {
      "additionalProperties": false,
      "properties": {
        "include": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "include"
      ],
      "type": "object"
    },
    "#Metadata": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "documentation": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/%23ResourceID"
        },
        "name": {
          "$ref": "#/$defs/%23ResourceName"
        },
        "owner": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/%23Provenance"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "#Provenance": {
      "additionalProperties": false,
      "properties": {
        "origin": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "#ResourceID": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "type": "string"
    },
    "#ResourceName": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "$ref": "#/$defs/%23APIVersion"
    },
    "kind": {
      "const": "Project"
    },
    "metadata": {
      "$ref": "#/$defs/%23Metadata"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "access": {
          "$ref": "#/$defs/%23IncludeList"
        },
        "connections": {
          "$ref": "#/$defs/%23IncludeList"
        },
        "dashboards": {
          "$ref": "#/$defs/%23IncludeList"
        },
        "models": {
          "$ref": "#/$defs/%23IncludeList"
        },
        "pipelines": {
          "$ref": "#/$defs/%23IncludeList"
        },
        "publications": {
          "$ref": "#/$defs/%23IncludeList"
        },
        "semanticModels": {
          "$ref": "#/$defs/%23IncludeList"
        },
        "sources": {
          "$ref": "#/$defs/%23IncludeList"
        }
      },
      "required": [
        "access",
        "connections",
        "dashboards",
        "models",
        "pipelines",
        "semanticModels",
        "sources"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "type": "object"
}
