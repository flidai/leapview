{
  "$defs": {
    "#APIVersion": {
      "const": "leapview.dev/v1"
    },
    "#AnyObject": {
      "additionalProperties": true,
      "type": "object"
    },
    "#DataPolicySubject": {
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "group": {
          "$ref": "#/$defs/%23ResourceID"
        },
        "kind": {
          "enum": [
            "principal",
            "group",
            "service_principal",
            "dashboard_publication"
          ]
        },
        "principalId": {
          "$ref": "#/$defs/%23ResourceID"
        },
        "publication": {
          "$ref": "#/$defs/%23ResourceID"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "#DataPolicyTarget": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/%23ResourceID"
        },
        "kind": {
          "enum": [
            "semantic_model",
            "source",
            "model"
          ]
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "type": "object"
    },
    "#Metadata": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "documentation": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/%23ResourceID"
        },
        "name": {
          "$ref": "#/$defs/%23ResourceName"
        },
        "owner": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/%23Provenance"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "#Provenance": {
      "additionalProperties": false,
      "properties": {
        "origin": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "#ResourceID": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "type": "string"
    },
    "#ResourceName": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "$ref": "#/$defs/%23APIVersion"
    },
    "kind": {
      "const": "DataPolicy"
    },
    "metadata": {
      "$ref": "#/$defs/%23Metadata"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "expression": {
          "$ref": "#/$defs/%23AnyObject"
        },
        "object": {
          "$ref": "#/$defs/%23DataPolicyTarget"
        },
        "policyType": {
          "enum": [
            "row_filter",
            "column_mask"
          ]
        },
        "subject": {
          "$ref": "#/$defs/%23DataPolicySubject"
        }
      },
      "required": [
        "expression",
        "object",
        "policyType"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "type": "object"
}
