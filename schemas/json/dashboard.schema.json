{
  "$defs": {
    "#APIVersion": {
      "const": "leapview.dev/v1"
    },
    "#DashboardAppearance": {
      "additionalProperties": false,
      "properties": {
        "color": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "#DashboardFilter": {
      "additionalProperties": false,
      "properties": {
        "control": {
          "$ref": "#/$defs/%23DashboardFilterControl"
        },
        "default": {
          "$ref": "#/$defs/%23DashboardFilterExpression"
        },
        "description": {
          "type": "string"
        },
        "dimension": {
          "$ref": "#/$defs/%23Identifier"
        },
        "id": {
          "$ref": "#/$defs/%23Identifier"
        },
        "label": {
          "type": "string"
        },
        "operators": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "readerEditable": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/%23Identifier"
          },
          "type": "array"
        },
        "urlParameter": {
          "$ref": "#/$defs/%23Identifier"
        }
      },
      "required": [
        "control",
        "dimension",
        "id",
        "label"
      ],
      "type": "object"
    },
    "#DashboardFilterControl": {
      "additionalProperties": false,
      "properties": {
        "maxSelectedValues": {
          "type": "integer"
        },
        "options": {
          "$ref": "#/$defs/%23DashboardFilterOptions"
        },
        "type": {
          "enum": [
            "singleSelect",
            "multiSelect",
            "text",
            "numericRange",
            "dateRange",
            "relativePeriod"
          ]
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "#DashboardFilterExpression": {
      "additionalProperties": true,
      "properties": {
        "type": {
          "enum": [
            "unfiltered",
            "nullCheck",
            "set",
            "comparison",
            "range",
            "relativePeriod"
          ]
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "#DashboardFilterOption": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/%23DashboardFilterValue"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "type": "object"
    },
    "#DashboardFilterOptions": {
      "additionalProperties": false,
      "properties": {
        "dataset": {
          "$ref": "#/$defs/%23Identifier"
        },
        "dependsOn": {
          "items": {
            "$ref": "#/$defs/%23Identifier"
          },
          "type": "array"
        },
        "includeNull": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer"
        },
        "type": {
          "enum": [
            "distinct",
            "static"
          ]
        },
        "values": {
          "items": {
            "$ref": "#/$defs/%23DashboardFilterOption"
          },
          "type": "array"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "#DashboardFilterValue": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string"
        },
        "value": true
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "#DashboardIncludes": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "filters": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "pages": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "visuals": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "#DashboardLayoutDefaults": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "type": "integer"
        },
        "gap": {
          "type": "integer"
        },
        "padding": {
          "type": "integer"
        },
        "rowHeight": {
          "type": "integer"
        }
      },
      "required": [
        "columns",
        "gap",
        "padding",
        "rowHeight"
      ],
      "type": "object"
    },
    "#DashboardPage": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "items": {
            "$ref": "#/$defs/%23DashboardPageComponent"
          },
          "type": "array"
        },
        "description": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/%23Identifier"
        },
        "layout": {
          "const": {}
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "components",
        "id",
        "title"
      ],
      "type": "object"
    },
    "#DashboardPageComponent": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "placement": {
          "$ref": "#/$defs/%23DashboardPlacement"
        },
        "type": {
          "enum": [
            "visual",
            "filter",
            "header"
          ]
        }
      },
      "required": [
        "id",
        "placement",
        "type"
      ],
      "type": "object"
    },
    "#DashboardPlacement": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "type": "integer"
        },
        "columnSpan": {
          "type": "integer"
        },
        "row": {
          "type": "integer"
        },
        "rowSpan": {
          "type": "integer"
        }
      },
      "required": [
        "column",
        "columnSpan",
        "row",
        "rowSpan"
      ],
      "type": "object"
    },
    "#DashboardQuery": {
      "additionalProperties": true,
      "properties": {
        "type": {
          "enum": [
            "aggregate",
            "records",
            "pivot",
            "histogram",
            "distribution"
          ]
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "#DashboardSpec": {
      "additionalProperties": false,
      "properties": {
        "appearance": {
          "$ref": "#/$defs/%23DashboardAppearance"
        },
        "filters": {
          "items": {
            "$ref": "#/$defs/%23DashboardFilter"
          },
          "type": "array"
        },
        "includes": {
          "$ref": "#/$defs/%23DashboardIncludes"
        },
        "layout": {
          "$ref": "#/$defs/%23DashboardLayoutDefaults"
        },
        "pages": {
          "items": {
            "$ref": "#/$defs/%23DashboardPage"
          },
          "minItems": 1,
          "type": "array"
        },
        "semanticModel": {
          "$ref": "#/$defs/%23ResourceID"
        },
        "visuals": {
          "additionalProperties": false,
          "minProperties": 1,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {
              "$ref": "#/$defs/%23DashboardVisual"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "filters",
        "pages",
        "semanticModel",
        "visuals"
      ],
      "type": "object"
    },
    "#DashboardVisual": {
      "additionalProperties": false,
      "properties": {
        "accessibility": {
          "const": {}
        },
        "calculations": {
          "type": "array"
        },
        "dataBudget": {
          "additionalProperties": false,
          "properties": {
            "maxRows": {
              "type": "integer"
            },
            "requiredCompleteness": {
              "type": "string"
            }
          },
          "required": [
            "maxRows"
          ],
          "type": "object"
        },
        "datasets": {
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {
              "$ref": "#/$defs/%23DashboardQuery"
            }
          },
          "type": "object"
        },
        "description": {
          "type": "string"
        },
        "interactions": {
          "type": "array"
        },
        "metadata": {
          "const": {}
        },
        "presentation": {
          "additionalProperties": true,
          "properties": {
            "type": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        "query": {
          "$ref": "#/$defs/%23DashboardQuery"
        },
        "subtitle": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "presentation",
        "query",
        "type"
      ],
      "type": "object"
    },
    "#Identifier": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "type": "string"
    },
    "#Metadata": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "documentation": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/%23ResourceID"
        },
        "name": {
          "$ref": "#/$defs/%23ResourceName"
        },
        "owner": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/%23Provenance"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "#Provenance": {
      "additionalProperties": false,
      "properties": {
        "origin": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "#ResourceID": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "type": "string"
    },
    "#ResourceName": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "$ref": "#/$defs/%23APIVersion"
    },
    "kind": {
      "const": "Dashboard"
    },
    "metadata": {
      "$ref": "#/$defs/%23Metadata"
    },
    "spec": {
      "$ref": "#/$defs/%23DashboardSpec"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "type": "object"
}
