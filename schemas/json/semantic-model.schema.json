{
  "$defs": {
    "#AIContext": {
      "additionalProperties": false,
      "properties": {
        "examples": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "instructions": {
          "type": "string"
        },
        "synonyms": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "#APIVersion": {
      "const": "leapview.dev/v1"
    },
    "#AggregateMetric": {
      "additionalProperties": false,
      "properties": {
        "aggregation": {
          "enum": [
            "sum",
            "count",
            "count_distinct",
            "avg",
            "min",
            "max"
          ]
        },
        "aiContext": {
          "$ref": "#/$defs/%23AIContext"
        },
        "dataset": {
          "$ref": "#/$defs/%23Identifier"
        },
        "description": {
          "type": "string"
        },
        "empty": {
          "enum": [
            "zero",
            "null"
          ]
        },
        "format": {
          "type": "string"
        },
        "hidden": {
          "type": "boolean"
        },
        "input": {
          "additionalProperties": false,
          "properties": {
            "field": {
              "$ref": "#/$defs/%23FieldRef"
            }
          },
          "required": [
            "field"
          ],
          "type": "object"
        },
        "label": {
          "type": "string"
        },
        "timeDimension": {
          "$ref": "#/$defs/%23Identifier"
        },
        "type": {
          "const": "aggregate"
        },
        "unit": {
          "type": "string"
        },
        "where": {
          "items": {
            "$ref": "#/$defs/%23Identifier"
          },
          "minItems": 1,
          "prefixItems": [
            {
              "$ref": "#/$defs/%23Identifier"
            }
          ],
          "type": "array"
        }
      },
      "required": [
        "aggregation",
        "dataset",
        "input",
        "type"
      ],
      "type": "object"
    },
    "#DerivedMetric": {
      "additionalProperties": false,
      "properties": {
        "aiContext": {
          "$ref": "#/$defs/%23AIContext"
        },
        "description": {
          "type": "string"
        },
        "expression": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "hidden": {
          "type": "boolean"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "const": "derived"
        },
        "unit": {
          "type": "string"
        }
      },
      "required": [
        "expression",
        "type"
      ],
      "type": "object"
    },
    "#DimensionBinding": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "$ref": "#/$defs/%23FieldRef"
        },
        "path": {
          "items": {
            "$ref": "#/$defs/%23Identifier"
          },
          "type": "array"
        }
      },
      "required": [
        "field"
      ],
      "type": "object"
    },
    "#EqualsFilter": {
      "additionalProperties": false,
      "properties": {
        "aiContext": {
          "$ref": "#/$defs/%23AIContext"
        },
        "field": {
          "$ref": "#/$defs/%23FieldRef"
        },
        "operator": {
          "const": "equals"
        },
        "path": {
          "items": {
            "$ref": "#/$defs/%23Identifier"
          },
          "type": "array"
        },
        "value": {
          "$ref": "#/$defs/%23Literal"
        }
      },
      "required": [
        "field",
        "operator",
        "value"
      ],
      "type": "object"
    },
    "#FieldRef": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*$",
      "type": "string"
    },
    "#FieldsRelationshipEndpoint": {
      "additionalProperties": false,
      "properties": {
        "dataset": {
          "$ref": "#/$defs/%23Identifier"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/%23Identifier"
          },
          "minItems": 1,
          "prefixItems": [
            {
              "$ref": "#/$defs/%23Identifier"
            }
          ],
          "type": "array"
        }
      },
      "required": [
        "dataset",
        "fields"
      ],
      "type": "object"
    },
    "#FilterLeaf": {
      "anyOf": [
        {
          "$ref": "#/$defs/%23EqualsFilter"
        },
        {
          "$ref": "#/$defs/%23NotEqualsFilter"
        },
        {
          "$ref": "#/$defs/%23InFilter"
        },
        {
          "$ref": "#/$defs/%23NotInFilter"
        },
        {
          "$ref": "#/$defs/%23LessThanFilter"
        },
        {
          "$ref": "#/$defs/%23LessThanOrEqualFilter"
        },
        {
          "$ref": "#/$defs/%23GreaterThanFilter"
        },
        {
          "$ref": "#/$defs/%23GreaterThanOrEqualFilter"
        },
        {
          "$ref": "#/$defs/%23IsNullFilter"
        },
        {
          "$ref": "#/$defs/%23IsNotNullFilter"
        }
      ]
    },
    "#FilterNode": {
      "anyOf": [
        {
          "$ref": "#/$defs/%23FilterLeaf"
        },
        {
          "additionalProperties": false,
          "properties": {
            "all": {
              "items": {
                "$ref": "#/$defs/%23FilterNode"
              },
              "minItems": 1,
              "prefixItems": [
                {
                  "$ref": "#/$defs/%23FilterNode"
                }
              ],
              "type": "array"
            }
          },
          "required": [
            "all"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "any": {
              "items": {
                "$ref": "#/$defs/%23FilterNode"
              },
              "minItems": 1,
              "prefixItems": [
                {
                  "$ref": "#/$defs/%23FilterNode"
                }
              ],
              "type": "array"
            }
          },
          "required": [
            "any"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "not": {
              "$ref": "#/$defs/%23FilterNode"
            }
          },
          "required": [
            "not"
          ],
          "type": "object"
        }
      ]
    },
    "#GreaterThanFilter": {
      "additionalProperties": false,
      "properties": {
        "aiContext": {
          "$ref": "#/$defs/%23AIContext"
        },
        "field": {
          "$ref": "#/$defs/%23FieldRef"
        },
        "operator": {
          "const": "greater_than"
        },
        "path": {
          "items": {
            "$ref": "#/$defs/%23Identifier"
          },
          "type": "array"
        },
        "value": {
          "$ref": "#/$defs/%23Literal"
        }
      },
      "required": [
        "field",
        "operator",
        "value"
      ],
      "type": "object"
    },
    "#GreaterThanOrEqualFilter": {
      "additionalProperties": false,
      "properties": {
        "aiContext": {
          "$ref": "#/$defs/%23AIContext"
        },
        "field": {
          "$ref": "#/$defs/%23FieldRef"
        },
        "operator": {
          "const": "greater_than_or_equal"
        },
        "path": {
          "items": {
            "$ref": "#/$defs/%23Identifier"
          },
          "type": "array"
        },
        "value": {
          "$ref": "#/$defs/%23Literal"
        }
      },
      "required": [
        "field",
        "operator",
        "value"
      ],
      "type": "object"
    },
    "#Identifier": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "type": "string"
    },
    "#InFilter": {
      "additionalProperties": false,
      "properties": {
        "aiContext": {
          "$ref": "#/$defs/%23AIContext"
        },
        "field": {
          "$ref": "#/$defs/%23FieldRef"
        },
        "operator": {
          "const": "in"
        },
        "path": {
          "items": {
            "$ref": "#/$defs/%23Identifier"
          },
          "type": "array"
        },
        "value": {
          "items": {
            "$ref": "#/$defs/%23Literal"
          },
          "minItems": 1,
          "prefixItems": [
            {
              "$ref": "#/$defs/%23Literal"
            }
          ],
          "type": "array"
        }
      },
      "required": [
        "field",
        "operator",
        "value"
      ],
      "type": "object"
    },
    "#IsNotNullFilter": {
      "additionalProperties": false,
      "properties": {
        "aiContext": {
          "$ref": "#/$defs/%23AIContext"
        },
        "field": {
          "$ref": "#/$defs/%23FieldRef"
        },
        "operator": {
          "const": "is_not_null"
        },
        "path": {
          "items": {
            "$ref": "#/$defs/%23Identifier"
          },
          "type": "array"
        }
      },
      "required": [
        "field",
        "operator"
      ],
      "type": "object"
    },
    "#IsNullFilter": {
      "additionalProperties": false,
      "properties": {
        "aiContext": {
          "$ref": "#/$defs/%23AIContext"
        },
        "field": {
          "$ref": "#/$defs/%23FieldRef"
        },
        "operator": {
          "const": "is_null"
        },
        "path": {
          "items": {
            "$ref": "#/$defs/%23Identifier"
          },
          "type": "array"
        }
      },
      "required": [
        "field",
        "operator"
      ],
      "type": "object"
    },
    "#LessThanFilter": {
      "additionalProperties": false,
      "properties": {
        "aiContext": {
          "$ref": "#/$defs/%23AIContext"
        },
        "field": {
          "$ref": "#/$defs/%23FieldRef"
        },
        "operator": {
          "const": "less_than"
        },
        "path": {
          "items": {
            "$ref": "#/$defs/%23Identifier"
          },
          "type": "array"
        },
        "value": {
          "$ref": "#/$defs/%23Literal"
        }
      },
      "required": [
        "field",
        "operator",
        "value"
      ],
      "type": "object"
    },
    "#LessThanOrEqualFilter": {
      "additionalProperties": false,
      "properties": {
        "aiContext": {
          "$ref": "#/$defs/%23AIContext"
        },
        "field": {
          "$ref": "#/$defs/%23FieldRef"
        },
        "operator": {
          "const": "less_than_or_equal"
        },
        "path": {
          "items": {
            "$ref": "#/$defs/%23Identifier"
          },
          "type": "array"
        },
        "value": {
          "$ref": "#/$defs/%23Literal"
        }
      },
      "required": [
        "field",
        "operator",
        "value"
      ],
      "type": "object"
    },
    "#Literal": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "#LogicalDataType": {
      "enum": [
        "String",
        "Integer",
        "Decimal",
        "Float",
        "Boolean",
        "Date",
        "Time",
        "DateTime",
        "DateTimeTz",
        "Opaque"
      ]
    },
    "#Metadata": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "documentation": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/%23ResourceID"
        },
        "name": {
          "$ref": "#/$defs/%23ResourceName"
        },
        "owner": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/%23Provenance"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "#Metric": {
      "anyOf": [
        {
          "$ref": "#/$defs/%23AggregateMetric"
        },
        {
          "$ref": "#/$defs/%23DerivedMetric"
        },
        {
          "$ref": "#/$defs/%23RatioMetric"
        }
      ]
    },
    "#NamedRelationshipEndpoint": {
      "additionalProperties": false,
      "properties": {
        "dataset": {
          "$ref": "#/$defs/%23Identifier"
        },
        "entity": {
          "$ref": "#/$defs/%23Identifier"
        }
      },
      "required": [
        "dataset",
        "entity"
      ],
      "type": "object"
    },
    "#NotEqualsFilter": {
      "additionalProperties": false,
      "properties": {
        "aiContext": {
          "$ref": "#/$defs/%23AIContext"
        },
        "field": {
          "$ref": "#/$defs/%23FieldRef"
        },
        "operator": {
          "const": "not_equals"
        },
        "path": {
          "items": {
            "$ref": "#/$defs/%23Identifier"
          },
          "type": "array"
        },
        "value": {
          "$ref": "#/$defs/%23Literal"
        }
      },
      "required": [
        "field",
        "operator",
        "value"
      ],
      "type": "object"
    },
    "#NotInFilter": {
      "additionalProperties": false,
      "properties": {
        "aiContext": {
          "$ref": "#/$defs/%23AIContext"
        },
        "field": {
          "$ref": "#/$defs/%23FieldRef"
        },
        "operator": {
          "const": "not_in"
        },
        "path": {
          "items": {
            "$ref": "#/$defs/%23Identifier"
          },
          "type": "array"
        },
        "value": {
          "items": {
            "$ref": "#/$defs/%23Literal"
          },
          "minItems": 1,
          "prefixItems": [
            {
              "$ref": "#/$defs/%23Literal"
            }
          ],
          "type": "array"
        }
      },
      "required": [
        "field",
        "operator",
        "value"
      ],
      "type": "object"
    },
    "#ProjectSemanticModelSpec": {
      "additionalProperties": false,
      "properties": {
        "datasets": {
          "additionalProperties": false,
          "minProperties": 1,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {
              "$ref": "#/$defs/%23SemanticDataset"
            }
          },
          "type": "object"
        },
        "dimensions": {
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {
              "$ref": "#/$defs/%23SemanticDimension"
            }
          },
          "type": "object"
        },
        "filters": {
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {
              "$ref": "#/$defs/%23SemanticFilter"
            }
          },
          "type": "object"
        },
        "metrics": {
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {
              "$ref": "#/$defs/%23Metric"
            }
          },
          "type": "object"
        },
        "relationships": {
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {
              "$ref": "#/$defs/%23Relationship"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "datasets",
        "metrics"
      ],
      "type": "object"
    },
    "#Provenance": {
      "additionalProperties": false,
      "properties": {
        "origin": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "#RatioMetric": {
      "additionalProperties": false,
      "properties": {
        "aiContext": {
          "$ref": "#/$defs/%23AIContext"
        },
        "denominator": {
          "$ref": "#/$defs/%23Identifier"
        },
        "description": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "hidden": {
          "type": "boolean"
        },
        "label": {
          "type": "string"
        },
        "numerator": {
          "$ref": "#/$defs/%23Identifier"
        },
        "type": {
          "const": "ratio"
        },
        "unit": {
          "type": "string"
        }
      },
      "required": [
        "denominator",
        "numerator",
        "type"
      ],
      "type": "object"
    },
    "#Relationship": {
      "additionalProperties": false,
      "properties": {
        "aiContext": {
          "$ref": "#/$defs/%23AIContext"
        },
        "description": {
          "type": "string"
        },
        "from": {
          "$ref": "#/$defs/%23RelationshipEndpoint"
        },
        "to": {
          "$ref": "#/$defs/%23RelationshipEndpoint"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "#RelationshipEndpoint": {
      "anyOf": [
        {
          "$ref": "#/$defs/%23NamedRelationshipEndpoint"
        },
        {
          "$ref": "#/$defs/%23FieldsRelationshipEndpoint"
        }
      ]
    },
    "#ResourceID": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "type": "string"
    },
    "#ResourceName": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
      "type": "string"
    },
    "#SemanticDataset": {
      "additionalProperties": false,
      "properties": {
        "aiContext": {
          "$ref": "#/$defs/%23AIContext"
        },
        "defaultTimeDimension": {
          "$ref": "#/$defs/%23Identifier"
        },
        "description": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/%23ResourceName"
        }
      },
      "required": [
        "model"
      ],
      "type": "object"
    },
    "#SemanticDimension": {
      "additionalProperties": false,
      "properties": {
        "aiContext": {
          "$ref": "#/$defs/%23AIContext"
        },
        "bindings": {
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {
              "$ref": "#/$defs/%23DimensionBinding"
            }
          },
          "type": "object"
        },
        "datatype": {
          "$ref": "#/$defs/%23LogicalDataType"
        },
        "description": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "time": {
          "$ref": "#/$defs/%23TimeSemantics"
        }
      },
      "required": [
        "bindings",
        "datatype"
      ],
      "type": "object"
    },
    "#SemanticFilter": {
      "$ref": "#/$defs/%23FilterNode"
    },
    "#TimeGrain": {
      "enum": [
        "second",
        "minute",
        "hour",
        "day",
        "week",
        "month",
        "quarter",
        "year"
      ]
    },
    "#TimeSemantics": {
      "additionalProperties": false,
      "properties": {
        "calendar": {
          "type": "string"
        },
        "grains": {
          "items": {
            "$ref": "#/$defs/%23TimeGrain"
          },
          "minItems": 1,
          "prefixItems": [
            {
              "$ref": "#/$defs/%23TimeGrain"
            }
          ],
          "type": "array"
        },
        "nativeGrain": {
          "$ref": "#/$defs/%23TimeGrain"
        },
        "timezone": {
          "type": "string"
        }
      },
      "required": [
        "grains",
        "nativeGrain"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "aiContext": {
      "$ref": "#/$defs/%23AIContext"
    },
    "apiVersion": {
      "$ref": "#/$defs/%23APIVersion"
    },
    "kind": {
      "const": "SemanticModel"
    },
    "metadata": {
      "$ref": "#/$defs/%23Metadata"
    },
    "spec": {
      "$ref": "#/$defs/%23ProjectSemanticModelSpec"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "type": "object"
}
