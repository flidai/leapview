{
  "$defs": {
    "#APIVersion": {
      "const": "leapview.dev/v1"
    },
    "#AccessSubject": {
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "group": {
          "$ref": "#/$defs/%23ResourceID"
        },
        "kind": {
          "enum": [
            "principal",
            "group",
            "service_principal"
          ]
        },
        "principalId": {
          "$ref": "#/$defs/%23ResourceID"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "#Metadata": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "documentation": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/%23ResourceID"
        },
        "name": {
          "$ref": "#/$defs/%23ResourceName"
        },
        "owner": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/%23Provenance"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "#Provenance": {
      "additionalProperties": false,
      "properties": {
        "origin": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "#ResourceID": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "type": "string"
    },
    "#ResourceName": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
      "type": "string"
    },
    "#RoleBinding": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "owner",
            "admin",
            "deployer",
            "data_deployer",
            "contributor",
            "editor",
            "member",
            "viewer"
          ]
        },
        "subject": {
          "$ref": "#/$defs/%23AccessSubject"
        }
      },
      "required": [
        "role",
        "subject"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "$ref": "#/$defs/%23APIVersion"
    },
    "kind": {
      "const": "RoleBinding"
    },
    "metadata": {
      "$ref": "#/$defs/%23Metadata"
    },
    "spec": {
      "$ref": "#/$defs/%23RoleBinding"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "type": "object"
}
