{
  "$defs": {
    "#AIContext": {
      "additionalProperties": false,
      "properties": {
        "examples": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "instructions": {
          "type": "string"
        },
        "synonyms": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "#APIVersion": {
      "const": "leapview.dev/v1"
    },
    "#Identifier": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "type": "string"
    },
    "#LogicalDataType": {
      "enum": [
        "String",
        "Integer",
        "Decimal",
        "Float",
        "Boolean",
        "Date",
        "Time",
        "DateTime",
        "DateTimeTz",
        "Opaque"
      ]
    },
    "#Metadata": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "documentation": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/%23ResourceID"
        },
        "name": {
          "$ref": "#/$defs/%23ResourceName"
        },
        "owner": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/%23Provenance"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "#Model": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "entities": {
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {
              "$ref": "#/$defs/%23ModelEntity"
            }
          },
          "type": "object"
        },
        "fields": {
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {
              "$ref": "#/$defs/%23ModelField"
            }
          },
          "type": "object"
        },
        "grain": {
          "additionalProperties": false,
          "properties": {
            "entity": {
              "$ref": "#/$defs/%23Identifier"
            }
          },
          "required": [
            "entity"
          ],
          "type": "object"
        },
        "source": {
          "$ref": "#/$defs/%23ResourceID"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/%23ResourceID"
          },
          "type": "array"
        },
        "sql": {
          "type": "string"
        },
        "transform": {
          "additionalProperties": false,
          "properties": {
            "sql": {
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "entities",
        "fields",
        "grain"
      ],
      "type": "object"
    },
    "#ModelEntity": {
      "additionalProperties": false,
      "properties": {
        "aiContext": {
          "$ref": "#/$defs/%23AIContext"
        },
        "description": {
          "type": "string"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/%23Identifier"
          },
          "minItems": 1,
          "prefixItems": [
            {
              "$ref": "#/$defs/%23Identifier"
            }
          ],
          "type": "array"
        },
        "type": {
          "enum": [
            "primary",
            "unique",
            "foreign",
            "natural"
          ]
        }
      },
      "required": [
        "fields",
        "type"
      ],
      "type": "object"
    },
    "#ModelField": {
      "additionalProperties": false,
      "properties": {
        "aiContext": {
          "$ref": "#/$defs/%23AIContext"
        },
        "datatype": {
          "$ref": "#/$defs/%23LogicalDataType"
        },
        "description": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "datatype"
      ],
      "type": "object"
    },
    "#Provenance": {
      "additionalProperties": false,
      "properties": {
        "origin": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "#ResourceID": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "type": "string"
    },
    "#ResourceName": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "aiContext": {
      "$ref": "#/$defs/%23AIContext"
    },
    "apiVersion": {
      "$ref": "#/$defs/%23APIVersion"
    },
    "kind": {
      "const": "Model"
    },
    "metadata": {
      "$ref": "#/$defs/%23Metadata"
    },
    "spec": {
      "$ref": "#/$defs/%23Model"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "type": "object"
}
