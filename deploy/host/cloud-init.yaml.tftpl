#cloud-config
write_files:
  - path: /usr/local/sbin/leapview-bootstrap
    owner: root:root
    permissions: "0700"
    encoding: b64
    content: ${bootstrap_b64}
%{ if revision019_compat_b64 != "" ~}
  - path: /usr/local/libexec/leapview-revision019-config-compat
    owner: root:root
    permissions: "0700"
    encoding: b64
    content: ${revision019_compat_b64}
  - path: /usr/local/libexec/leapview-postgres-init
    owner: root:root
    permissions: "0755"
    encoding: b64
    content: ${revision019_postgres_init_b64}
  - path: /run/leapview/bootstrap-controller-image
    owner: root:root
    permissions: "0600"
    encoding: b64
    content: ${bootstrap_controller_image_b64}
%{ endif ~}
  - path: /run/leapview/bootstrap.json
    owner: root:root
    permissions: "0600"
    encoding: b64
    content: ${config_b64}
  - path: /run/leapview/image-reference
    owner: root:root
    permissions: "0600"
    encoding: b64
    content: ${image_b64}
runcmd:
  - [/usr/local/sbin/leapview-bootstrap]
