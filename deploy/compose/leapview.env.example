LEAPVIEW_PRODUCTION=1
LEAPVIEW_ENVIRONMENT=prod
LEAPVIEW_ADDR=:8080
LEAPVIEW_HOME=/var/lib/leapview/home
LEAPVIEW_MANAGED_DATA_BACKEND=local
LEAPVIEW_MANAGED_DATA_DIR=/var/lib/leapview/home/managed-data
LEAPVIEW_LOCAL_AUTH=1
LEAPVIEW_COOKIE_SECURE=true
LEAPVIEW_TRUST_PROXY_HEADERS=true
LEAPVIEW_PUBLIC_URL=https://dash.example.com
LEAPVIEW_ALLOWED_HOSTS=dash.example.com
LEAPVIEW_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
LEAPVIEW_CSRF_KEY=<generated-by-leapviewctl>
LEAPVIEW_METRICS_BEARER_TOKEN=<generated-by-leapviewctl>

# Production uses an external/provider-owned PostgreSQL service. Provision the
# two databases and least-privilege roles, then replace every empty value
# below before running leapviewctl init. The controller preserves these values.
LEAPVIEW_POSTGRES_CONTROL_URL=
LEAPVIEW_POSTGRES_CONTROL_MIGRATOR_URL=
LEAPVIEW_POSTGRES_CONTROL_MIGRATOR_ROLE=leapview_control_migrator
LEAPVIEW_POSTGRES_CONTROL_RUNTIME_ROLE=leapview_control_runtime
LEAPVIEW_POSTGRES_CONTROL_MAINTENANCE_URL=
LEAPVIEW_POSTGRES_CONTROL_MAINTENANCE_ROLE=leapview_control_maintenance
LEAPVIEW_POSTGRES_DUCKLAKE_URL=
LEAPVIEW_POSTGRES_DUCKLAKE_RUNTIME_ROLE=leapview_ducklake_runtime
LEAPVIEW_POSTGRES_DUCKLAKE_MAINTENANCE_URL=
LEAPVIEW_POSTGRES_DUCKLAKE_MAINTENANCE_ROLE=leapview_ducklake_maintenance
LEAPVIEW_POSTGRES_REQUIRE_TLS=true

# Delivery pool admission is target-owned. Before init, run bootstrap without
# --apply and copy its deterministic identities here. After init has created
# the control baseline, repeat the same command with --apply. Supply the
# operation-only DuckLake migrator credential only to that command; do not put
# it in this serving environment.
LEAPVIEW_DELIVERY_PHYSICAL_POOL_ID=
LEAPVIEW_DELIVERY_PHYSICAL_POOL_COMPATIBILITY_DIGEST=
