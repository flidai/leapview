# Copy to private .kamal/secrets. Values are supplied by the operator/CI environment.
# Kamal writes secret environment files on the target host; protect root/Docker access.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
LEAPVIEW_CSRF_KEY=$LEAPVIEW_CSRF_KEY
LEAPVIEW_METRICS_BEARER_TOKEN=$LEAPVIEW_METRICS_BEARER_TOKEN
LEAPVIEW_POSTGRES_CONTROL_URL=$LEAPVIEW_POSTGRES_CONTROL_URL
LEAPVIEW_POSTGRES_DUCKLAKE_URL=$LEAPVIEW_POSTGRES_DUCKLAKE_URL
LEAPVIEW_AGENT_CREDENTIAL_KEY=$LEAPVIEW_AGENT_CREDENTIAL_KEY
LEAPVIEW_POSTGRES_CONTROL_MAINTENANCE_URL=$LEAPVIEW_POSTGRES_CONTROL_MAINTENANCE_URL
LEAPVIEW_POSTGRES_DUCKLAKE_MAINTENANCE_URL=$LEAPVIEW_POSTGRES_DUCKLAKE_MAINTENANCE_URL
LEAPVIEW_OIDC_CLIENT_SECRET=$LEAPVIEW_OIDC_CLIENT_SECRET
