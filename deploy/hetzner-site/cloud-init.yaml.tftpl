#cloud-config
package_update: true
package_upgrade: true
package_reboot_if_required: true
packages:
  - ca-certificates
  - curl
  - python3
  - docker.io
  - docker-compose-v2
  - unattended-upgrades

write_files:
  - path: /opt/leapview-site/compose.yaml
    owner: root:root
    permissions: "0644"
    encoding: b64
    content: ${compose_b64}
  - path: /opt/leapview-site/Caddyfile
    owner: root:root
    permissions: "0644"
    encoding: b64
    content: ${caddyfile_b64}
  - path: /opt/leapview-site/deployment.env
    owner: root:root
    permissions: "0600"
    encoding: b64
    content: ${deployment_env_b64}
  - path: /opt/leapview-site/provision.sh
    owner: root:root
    permissions: "0700"
    encoding: b64
    content: ${provision_b64}
  - path: /opt/leapview-site/deploy.sh
    owner: root:root
    permissions: "0700"
    encoding: b64
    content: ${deploy_b64}
  - path: /opt/leapview-site/site_image_retention.py
    owner: root:root
    permissions: "0700"
    encoding: b64
    content: ${retention_b64}
  - path: /opt/leapview-site/reconcile.sh
    owner: root:root
    permissions: "0700"
    encoding: b64
    content: ${reconcile_b64}
  - path: /etc/systemd/system/leapview-site-reconcile.service
    owner: root:root
    permissions: "0644"
    encoding: b64
    content: ${reconcile_service_b64}
  - path: /etc/systemd/system/leapview-site-reconcile.timer
    owner: root:root
    permissions: "0644"
    encoding: b64
    content: ${reconcile_timer_b64}

runcmd:
  - [bash, /opt/leapview-site/provision.sh]
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, leapview-site-reconcile.timer]
