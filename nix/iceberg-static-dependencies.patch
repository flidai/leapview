+# One controlled native closure shared with the engine's HTTP/CRoaring builds.
+foreach(required ICEBERG_AWS_LIBRARIES ICEBERG_HTTP_LIBRARIES ICEBERG_ROARING_LIBRARY ICEBERG_INCLUDE_DIRS)
+  if(NOT DEFINED ${required})
+    message(FATAL_ERROR "Missing selected Iceberg input: ${required}")
+  endif()
+endforeach()
+foreach(target ${EXTENSION_NAME} ${TARGET_NAME}_loadable_extension)
+  target_include_directories(${target} PRIVATE ${ICEBERG_INCLUDE_DIRS})
+  target_link_libraries(${target} -Wl,--start-group ${ICEBERG_AWS_LIBRARIES}
+    ${ICEBERG_HTTP_LIBRARIES} ${ICEBERG_ROARING_LIBRARY} -Wl,--end-group)
+endforeach()
