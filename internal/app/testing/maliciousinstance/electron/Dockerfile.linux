FROM oven/bun:1.4.0-debian@sha256:5bb0f9be3a1a36a03e27c9a9dd894a3b1ad26657155c7df4dda771e17bf872ef AS electron

WORKDIR /proof
COPY internal/app/testing/maliciousinstance/electron/package.json ./
COPY internal/app/testing/maliciousinstance/electron/bun.lock ./
RUN bun install --frozen-lockfile \
    && node node_modules/electron/install.js

FROM golang:1.27-bookworm

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        dbus-x11 \
        libasound2 \
        libatk-bridge2.0-0 \
        libatspi2.0-0 \
        libcups2 \
        libdrm2 \
        libgbm1 \
        libgtk-3-0 \
        libnss3 \
        libx11-xcb1 \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxkbcommon0 \
        libxrandr2 \
        libxss1 \
        xauth \
        xvfb \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY go.mod go.sum ./
COPY internal/app/testing/maliciousinstance ./internal/app/testing/maliciousinstance
COPY desktop/src/security ./desktop/src/security
COPY --from=electron /proof/node_modules ./internal/app/testing/maliciousinstance/electron/node_modules

RUN cp internal/app/testing/maliciousinstance/electron/run-linux-proof.sh /usr/local/bin/run-linux-proof \
    && chmod 755 /usr/local/bin/run-linux-proof \
    && useradd --create-home --uid 10001 proof \
    && chown -R proof:proof /src \
    && chown root:root internal/app/testing/maliciousinstance/electron/node_modules/electron/dist/chrome-sandbox \
    && chmod 4755 internal/app/testing/maliciousinstance/electron/node_modules/electron/dist/chrome-sandbox \
    && mkdir -p /tmp/.X11-unix \
    && chmod 1777 /tmp/.X11-unix

USER proof

ENV LEAPVIEW_ELECTRON_BINARY=/src/internal/app/testing/maliciousinstance/electron/node_modules/electron/dist/electron

CMD ["/usr/local/bin/run-linux-proof"]
