  "roles": [
    {
      "role": "viewer",
      "profile": "leapview.permissions/v1",
      "description": "View approved dashboards and consume explicitly scoped semantic data.",
      "actions": [
        "dashboard.read",
        "semantic.consume"
      ]
    },
    {
      "role": "explorer",
      "profile": "leapview.permissions/v1",
      "description": "View approved dashboards and discover and query explicitly scoped semantic data.",
      "actions": [
        "dashboard.read",
        "semantic.read",
        "semantic.consume",
        "semantic.query"
      ]
    },
    {
      "role": "editor",
      "profile": "leapview.permissions/v1",
      "description": "Explore governed data and create or update authored resources without publish, delete, share, run, or administration authority.",
      "actions": [
        "dashboard.read",
        "dashboard.create",
        "dashboard.update",
        "semantic.read",
        "semantic.consume",
        "semantic.query",
        "semantic.create",
        "semantic.update",
        "source.read",
        "source.create",
        "source.update",
        "model.read",
        "model.create",
        "model.update",
        "pipeline.read",
        "pipeline.create",
        "pipeline.update",
        "connection.read",
        "connection.create",
        "connection.use"
      ]
    },
    {
      "role": "project_admin",
      "profile": "leapview.permissions/v1",
      "description": "Manage Project settings and access without acquiring semantic data or platform authority.",
      "actions": [
        "project.settings.read",
        "project.settings.update",
        "project.access.read",
        "project.access.manage",
        "project.access.delegate",
        "audit.read"
      ]
    },
    {
      "role": "publisher",
      "profile": "leapview.permissions/v1",
      "description": "Publish explicitly scoped dashboards without editing, deletion, sharing, or release authority.",
      "actions": [
        "dashboard.read",
        "dashboard.publish"
      ]
    },
    {
      "role": "release_approver",
      "profile": "leapview.permissions/v1",
      "description": "Inspect and approve protected delivery candidates.",
      "actions": [
        "delivery.read",
        "delivery.approve"
      ]
    },
    {
      "role": "release_operator",
      "profile": "leapview.permissions/v1",
      "description": "Plan, build, publish, activate, and roll back qualified releases without approval authority.",
      "actions": [
        "delivery.read",
        "delivery.plan",
        "delivery.build",
        "delivery.publish",
        "delivery.activate",
        "delivery.rollback"
      ]
    },
    {
      "role": "auditor",
      "profile": "leapview.permissions/v1",
      "description": "Inspect Project access, delivery evidence, and audit events without mutation authority.",
      "actions": [
        "project.access.read",
        "delivery.read",
        "audit.read"
      ]
    }
  ]
}
